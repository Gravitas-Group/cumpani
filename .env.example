# Environment variables example for local development and CI
# Copy to .env and fill in real secrets before running

# Postgres
DATABASE_URL=postgresql://cumpani:password@localhost:5432/cumpani_dev

# Auth.js / OAuth
AUTH_SECRET=replace_with_strong_random_value
# If using OAuth providers, add client IDs/secrets here
# e.g. GOOGLE_CLIENT_ID=...
# GOOGLE_CLIENT_SECRET=...

# Redis
REDIS_URL=redis://localhost:6379

# Stripe
STRIPE_SECRET_KEY=sk_test_replace
STRIPE_WEBHOOK_SECRET=whsec_replace

# Next.js
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace
NEXTAUTH_URL=http://localhost:3000

# Session/cookies
COOKIE_SECRET=replace_with_another_strong_value

# Sentry / monitoring (optional)
SENTRY_DSN=
